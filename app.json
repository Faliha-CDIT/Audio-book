{
  "expo": {
    "name": "Sarva Audios",
    "slug": "Audio-Book",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon-3.png",
    "scheme": "audiobook",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cdit.audiobook"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-3.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cdit.audiobook",
      "allowBackup": false,
      "fullBackupContent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon-3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-3.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "allowBackup": false
          },
          "ios": {
            "allowBackup": false
          }
        }
      ],
      "./plugins/withNetworkSecurityConfig"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "af84b6ae-cd92-436d-992e-5e0aeb826425"
      }
    }
  }
}
